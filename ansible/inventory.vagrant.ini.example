# cp inventory.vagrant.ini.example inventory.vagrant.ini
# Run from the ansible/ directory:  ansible-playbook -i inventory.vagrant.ini playbooks/X.yml
[lab]
vg-debian ansible_host=192.168.56.11
vg-ubuntu ansible_host=192.168.56.12

[lab:vars]
ansible_user=vagrant
# The key is generated by Vagrant; path is relative to the ansible/ directory
ansible_ssh_private_key_file=../.vagrant/machines/{{ inventory_hostname }}/virtualbox/private_key
# VMs are recreated often, so host keys are not pinned (local lab only!)
ansible_ssh_common_args=-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null
